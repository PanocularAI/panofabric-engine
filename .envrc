# nix-direnv provides `use flake`. home-manager supplies it on the cluster;
# elsewhere (e.g. the devcontainer) fetch this hash-pinned copy instead.
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

if [ -f .envrc.local ]; then
  # Per-developer override, gitignored: picks a non-default devShell from
  # flake.nix (e.g. `use flake .#rl` for the matched RL runtime) instead of
  # this falling through to the plain `use flake` below.
  source_env .envrc.local
else
  use flake
fi
